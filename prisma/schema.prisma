generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Orders {
  id         Int      @id @default(autoincrement())
  orderId    String   @unique
  phone      String
  cpf        String
  externalId String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
}

model QueueTraining {
  id        String   @id @default(uuid())
  status    Boolean  @default(false) // true se subiu no pinecone ou false se não.
  type      String // image ou text
  productId BigInt // id do produto 
  content   String // nome do produto, link do produto ou descrição
  metadata  Json? // para as imagens vai armazenar os variantIds
  updatedAt DateTime @default(now()) @updatedAt
  createdAt DateTime @default(now())
}

model ShopInstances {
  id          Int      @id @default(autoincrement())
  instanceId  String   @unique // ID da instância do ZAPI
  shopKey     String   // Chave da loja no config.js
  name        String   // Nome da loja para exibição
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}