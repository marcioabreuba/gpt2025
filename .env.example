# Exemplo de arquivo .env com as configurações principais

# Configuração do servidor
PORT=3000

# Configuração de logs
# Valores possíveis: error, warn, info, debug, trace
# info - apenas mensagens básicas (padrão)
# debug - informações detalhadas para depuração
# trace - todos os detalhes, incluindo dados sensíveis
LOG_LEVEL=info

# Configuração do ambiente
# development - permite logs completos e detalhados
# production - logs otimizados para produção
NODE_ENV=production

# Outras configurações do seu projeto...
# DATABASE_URL=...
# OPENAI_API_KEY=...
# etc... 